# =============================================================================
# ChildBloom — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (REQUIRED)
# -----------------------------------------------------------------------------
# Your Supabase project URL — find it in Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_ID=your-project-ref

# Anon (publishable) key — safe for client-side use
SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Service role key — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Vite-prefixed versions for client-side access (only the anon key!)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# Site (REQUIRED)
# -----------------------------------------------------------------------------
SITE_URL=https://childbloom.site

# -----------------------------------------------------------------------------
# Email Service (optional — needed for newsletter delivery)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=***
RESEND_API_KEY=your-resend-api-key

# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
# PLAUSIBLE_DOMAIN=childbloom.site
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GA_MEASUREMENT_ID=G-HDMR4R55ND

# -----------------------------------------------------------------------------
# Error Monitoring (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=https://cb257dc41e94948804272445c7446332@o4508327566901248.ingest.us.sentry.io/4511531847909376
VITE_SENTRY_DSN=https://cb257dc41e94948804272445c7446332@o4508327566901248.ingest.us.sentry.io/4511531847909376

# -----------------------------------------------------------------------------
# Google AdSense (optional — needed for ad monetization)
# -----------------------------------------------------------------------------
# ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx
